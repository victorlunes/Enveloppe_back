# Copie este arquivo para ".env" e preencha com os seus valores

# Usuário master do Postgres (usado pelo docker-compose só na criação do banco)
POSTGRES_USER=
POSTGRES_PASSWORD=

# Usuário da aplicação (usado pelo Spring)
# local: jdbc:postgresql://localhost:5433/enveloppedb
# no docker-compose.example.yaml a URL já é definida lá dentro
DATABASE_URL=jdbc:postgresql://localhost:5433/enveloppedb
DATABASE_USERNAME=
DATABASE_PASSWORD=
